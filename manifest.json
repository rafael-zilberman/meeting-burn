{
  "manifest_version": 3,
  "name": "Meeting Burn",
  "version": "1.1.0",
  "description": "Watch your meeting burn money in real time. No accounts, no network, no tracking.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel"],
  "action": {
    "default_title": "Meeting Burn",
    "default_popup": "index.html?surface=popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?surface=panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
